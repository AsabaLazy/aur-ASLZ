# Maintainer: GopeedLab <https://github.com/GopeedLab/gopeed>
pkgname=gopeed-bin
pkgver=1.9.3
pkgrel=1
pkgdesc="High speed downloader that supports all platforms (official prebuilt binary)"
arch=('x86_64')
url="https://gopeed.com"
license=('GPL-3.0-only')
depends=('gtk3' 'libdbusmenu-glib' 'libayatana-appindicator' 'libayatana-indicator' 'ayatana-ido' 'libkeybinder3')
provides=('gopeed')
conflicts=('gopeed')
options=('!debug' '!strip')
source_x86_64=("gopeed-${pkgver}.deb::https://github.com/GopeedLab/gopeed/releases/download/v1.9.3/Gopeed-v1.9.3-linux-amd64.deb")
sha256sums_x86_64=('23d7caa11877ad0a21d6f1a8f1e00e23606ccf9fe2953a3d045046a2950946e5')

package() {
  bsdtar -xf data.tar.* -C "${pkgdir}"
  install -dm755 "${pkgdir}/usr/bin"
  ln -sf /opt/gopeed/gopeed "${pkgdir}/usr/bin/gopeed"
}
