# Maintainer: GopeedLab <https://github.com/GopeedLab/gopeed>
pkgname=gopeed-bin
pkgver=2.0.0
pkgrel=1
pkgdesc="High speed downloader that supports all platforms (official prebuilt binary)"
arch=('x86_64')
url="https://gopeed.com"
license=('GPL-3.0-only')
depends=('gtk3' 'libdbusmenu-glib' 'libayatana-appindicator' 'libayatana-indicator' 'ayatana-ido' 'libkeybinder3')
provides=('gopeed')
conflicts=('gopeed')
options=('!debug' '!strip')
source_x86_64=("gopeed-${pkgver}.deb::https://github.com/GopeedLab/gopeed/releases/download/v2.0.0/Gopeed-v2.0.0-linux-amd64.deb")
sha256sums_x86_64=('7cead8afab4f9ce1ce17502f8336540c80e21e9ff2bc0cd4a40bf2b3a13d15d1')

package() {
  bsdtar -xf data.tar.* -C "${pkgdir}"
  install -dm755 "${pkgdir}/usr/bin"
  ln -sf /opt/gopeed/gopeed "${pkgdir}/usr/bin/gopeed"
}
