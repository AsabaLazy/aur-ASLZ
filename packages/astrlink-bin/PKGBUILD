sha256sums_x86_64=('330d8ef96a8f69685cc538edb6b5a4be148185350f15f4c82f043a180ebab0c1')

package() {
  bsdtar -xf data.tar.* -C "${pkgdir}"
  ln -sf astrlink-desktop "${pkgdir}/usr/bin/astrlink"
}
