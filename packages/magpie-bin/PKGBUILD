# Maintainer: yetone <https://github.com/yetone/magpie>
pkgname=magpie-bin
pkgver=0.1.3097
pkgrel=1
pkgdesc="Every agent's model. One place. Codex on DeepSeek, Claude Code on Kimi, from menu bar"
arch=('x86_64')
url="https://github.com/yetone/magpie"
license=('MIT')
depends=('glib2' 'gtk3' 'gdk-pixbuf2' 'hicolor-icon-theme' 'libsoup3' 'libx11' 'webkit2gtk-4.1')
provides=('magpie')
conflicts=('magpie')
options=('!debug' '!strip')
source_x86_64=("magpie-${pkgver}::https://github.com/yetone/magpie/releases/download/v0.1.3097/magpie-linux-amd64"
               "magpie.desktop"
               "magpie.png")
sha256sums_x86_64=('0b8bba64740947970132c73dc13d88a3e01d2699b920f83f69aff410ea3405d2'
                   '7e8ad08b3ab30057e7f05a66a62d8cec9fe384be5ec68558f8bfbd3ec819df9f'
                   '57437c6596e05a8fcfc42d4288c030aa00ed86b69fe35d464d69d7026150c704')

package() {
  install -Dm755 "${srcdir}/magpie-${pkgver}" "${pkgdir}/usr/bin/magpie"
  install -Dm644 "${srcdir}/magpie.desktop" "${pkgdir}/usr/share/applications/magpie.desktop"
  install -Dm644 "${srcdir}/magpie.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/magpie.png"
}
