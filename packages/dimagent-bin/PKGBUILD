# Maintainer: Shanghai Fazhi Technology Co., Ltd <support@dimagent.cn>
pkgname=dimagent-bin
pkgver=0.9.58
pkgrel=1
pkgdesc="DimAgent desktop client — AI coding agent"
arch=('x86_64')
url="https://dimagent.cn"
license=('LicenseRef-DimAgent-EULA')
depends=('gtk3' 'nss' 'alsa-lib' 'libcups' 'libxtst' 'libxss' 'libsecret' 'libnotify' 'at-spi2-core' 'mesa' 'xdg-utils')
optdepends=('libappindicator-gtk3: tray icon on desktops without StatusNotifier')
provides=('dimagent')
conflicts=('dimagent')
options=('!debug' '!strip')
source_x86_64=("${pkgname}-${pkgver}.deb::https://dimcode.echooai.com/updates/stable/linux/x64/DimAgent-0.9.58.deb")
sha256sums_x86_64=('0d5bcf4e3099da734324bcf6b3f521537ac38e79e998386a6ce65285fae14118')

package() {
  bsdtar -xf data.tar.* -C "${pkgdir}"
  rm -rf "${pkgdir}/usr/share/doc"
  chmod 4755 "${pkgdir}/opt/DimAgent/chrome-sandbox" 2>/dev/null || true
  install -dm755 "${pkgdir}/usr/bin"
  ln -sf /opt/DimAgent/DimAgent "${pkgdir}/usr/bin/dimagent"
  ln -sf /opt/DimAgent/DimAgent "${pkgdir}/usr/bin/dimagent-desktop"

  install -dm755 "${pkgdir}/usr/share/icons/hicolor/512x512/apps" "${pkgdir}/usr/share/pixmaps"
  ln -sf /usr/share/icons/hicolor/1024x1024/apps/DimAgent.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/DimAgent.png"
  ln -sf /usr/share/icons/hicolor/1024x1024/apps/DimAgent.png "${pkgdir}/usr/share/pixmaps/DimAgent.png"
}
