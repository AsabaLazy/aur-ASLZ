# Maintainer: Google LLC <https://github.com/google-antigravity/antigravity-cli>
pkgname=antigravity-cli-fix-bin
pkgver=1.4.12
pkgrel=1
pkgdesc="Google's agentic development platform (CLI companion, patched to unlock 900K context window and remove 256K compaction clamp)"
arch=('x86_64')
url="https://antigravity.google"
license=('custom:proprietary')
depends=('glibc')
optdepends=('antigravity: authenticate and share session state with desktop application')
provides=('antigravity-cli' 'antigravity-cli-bin' 'agy')
conflicts=('antigravity-cli' 'antigravity-cli-bin' 'agy')
options=('!debug' '!strip')
source_x86_64=("${pkgname}-${pkgver}.tar.gz::https://github.com/google-antigravity/antigravity-cli/releases/download/1.4.12/agy_cli_linux_x64.tar.gz")
sha256sums_x86_64=('3368d1923fc869f21ec8fce83252a8c96c89283aac9393958ac91fbf7a3949e4')

package() {
  install -Dm755 "${srcdir}/antigravity" "${pkgdir}/usr/bin/agy"
  python3 "${startdir}/patch_agy.py" "${pkgdir}/usr/bin/agy"
  rm -f "${pkgdir}/usr/bin/agy.bak"
}
