# Maintainer: AsabaLazy <https://github.com/AsabaLazy/gopeed-fluent>
pkgname=gopeed-fluent-bin
pkgver=1.9.3
pkgrel=1
pkgdesc="High speed downloader with Fluent UI (official prebuilt binary)"
arch=('x86_64')
url="https://github.com/AsabaLazy/gopeed-fluent"
license=('GPL-3.0-only')
depends=('gtk3' 'libdbusmenu-glib' 'libayatana-appindicator' 'libayatana-indicator' 'ayatana-ido' 'libkeybinder3')
provides=('gopeed-fluent')
conflicts=('gopeed-fluent')
options=('!debug' '!strip')
source_x86_64=("${pkgname}-${pkgver}.deb::https://github.com/AsabaLazy/gopeed-fluent/releases/download/v${pkgver}/Gopeed_Fluent_${pkgver}_linux_amd64.deb")
sha256sums_x86_64=('SKIP')

package() {
  bsdtar -xf data.tar.* -C "${pkgdir}"
  install -dm755 "${pkgdir}/usr/bin"
  ln -sf /opt/gopeed/gopeed "${pkgdir}/usr/bin/gopeed-fluent"
}
